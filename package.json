{
  "name": "task-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "dev": "wrangler dev --test-scheduled --persist-to .wrangler-local",
    "dev:client": "vite",
    "start": "wrangler dev --test-scheduled --persist-to .wrangler-local",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply task-app-db --local --persist-to .wrangler-local",
    "db:migrate:remote": "wrangler d1 migrations apply task-app-db --remote"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.5.2",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "vue": "^3.5.45"
  }
}
